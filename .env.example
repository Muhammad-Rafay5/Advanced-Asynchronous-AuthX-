# --- Security & Core ---
PROJECT_NAME="Advanced Asynchronous Backend"
ACCESS_TOKEN_SECRET="change_this_to_a_long_random_secret"
REFRESH_TOKEN_SECRET="change_this_to_a_different_long_random_secret"
ALGORITHM="HS256"

# --- Token Lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL Database ---
# Local development: Ensure a PostgreSQL instance is running on your machine.
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/auth_system"

# --- Connection Pool ---
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379

# --- CORS ---
# Add your frontend origin here (comma-separated for multiple)
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000"

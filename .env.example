# --- Security & Core ---
PROJECT_NAME="Advanced Asynchronous Backend"
ACCESS_TOKEN_SECRET="your_access_token_secret_here"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_here"
ALGORITHM="HS256"

# --- Token Lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Databases ---
# Dev (SQLite): sqlite+aiosqlite:///./auth_system.db
# Prod (Docker): postgresql+asyncpg://postgres:password@db:5432/auth_system
DATABASE_URL="postgresql+asyncpg://postgres:password@db:5432/auth_system"

# --- Redis ---
REDIS_HOST="redis"
REDIS_PORT=6379

# --- CORS ---
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"
